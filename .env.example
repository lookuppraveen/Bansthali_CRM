# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Auth.js (NextAuth) ────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-with-random-32-byte-base64
NEXTAUTH_URL=http://localhost:3007
AUTH_TRUST_HOST=true

# ── AI Assistant ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM="Banasthali Admissions <onboarding@resend.dev>"

# ── WhatsApp (Gupshup) ────────────────────────────────────
GUPSHUP_API_KEY=sk_...
GUPSHUP_APP_NAME=banasthali-crm
GUPSHUP_SOURCE_NUMBER=917834811114

# ── SMS (MSG91) ───────────────────────────────────────────
MSG91_AUTH_KEY=...
MSG91_SENDER_ID=MSGIND

# ── Payments (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=
